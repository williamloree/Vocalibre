{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Settings and history window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:default",
    "allow-get-status",
    "allow-get-lang",
    "allow-get-settings",
    "allow-update-settings",
    "allow-reset-settings",
    "allow-suspend-hotkey",
    "allow-list-models",
    "allow-select-model",
    "allow-delete-model",
    "allow-download-model",
    "allow-cancel-download",
    "allow-benchmark",
    "allow-hardware",
    "allow-finish-onboarding",
    "allow-list-microphones",
    "allow-get-history",
    "allow-clear-history",
    "allow-copy-text",
    "allow-open-logs-dir",
    "allow-open-models-dir",
    "allow-app-info"
  ]
}
